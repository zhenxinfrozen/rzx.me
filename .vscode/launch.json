{
    // PHP Xdebug launch configuration for VS Code
    // 使用 "Listen for XDebug" 在 VS Code 中接收来自 PHP 的 Xdebug 连接
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for XDebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        },
        {
            "name": "启动内置服务器 and Debug",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-S",
                "127.0.0.1:8000",
                "-t",
                "public",
                "public/dev-server.php"
            ],
            "port": 9003,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Development Server \\(http://127.0.0.1:8000\\) started",
                "uriFormat": "http://127.0.0.1:8000/admin?page=dashboard"
            },
            "pathMappings": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        }
    ]
}
