# Ignore local backups and editor/temp files
includes_css_backup.zip
*.log
.DS_Store
.vscode/
node_modules/

# 动态配置文件（由后台系统自动维护）
app/storage/config/*.json
!app/storage/config/.gitkeep

# Media assets
public/assets/images/*
!public/assets/images/.gitkeep
!public/assets/images/website-screenshot/
!public/assets/images/website-screenshot/*
public/assets/videos/*
!public/assets/videos/.gitkeep

# SharedAdmin public junction/symlink
public/shared-admin
public/shared-layout
public/lab

# lab 实验目录 (含硬编码凭据, 待清理后再考虑纳入版本控制)
/lab/

